;; GHOST HACKER: FLOW — host adapters (ADR-2607023200). The groove-sync
;; judgment core moved to com-junkawasaki/ghosthacker-groove-core per
;; ADR-2607032600 — this repo now holds only FLOW's own host adapters
;; (demo.clj / terminal.clj) plus the network-isekai guest-language port.
{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com-junkawasaki/ghosthacker-groove-core
        {:git/url "https://github.com/com-junkawasaki/ghosthacker-groove-core.git"
         :sha "67e9ef2b1bba0e0c64f5366f9813338374bebfae"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  ;; Browser host adapter (ADR-2607100900 follow-up (b)): plain reagent,
  ;; Web Audio for both the beat clock and a synthesized tick (no composed
  ;; music layers exist yet, so :groove drives a visual TENSE<->Sky High
  ;; crossfade instead of an audio one -- see web.cljs docstring). Visual
  ;; layer is kotoba-lang/webgpu (declarative WebGPU-from-EDN, no Rust/wasm
  ;; -- CLAUDE.md's "no new Rust crates for app rendering" rule, 2026-07-10)
  ;; -- :local/root like network-isekai's real usage of the same lib, so
  ;; this build only resolves from within the west-managed monorepo
  ;; checkout (same constraint network-isekai already has); the JVM
  ;; :test/:lint aliases below never touch this path, so CI (which only
  ;; runs those) is unaffected.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent           {:mvn/version "1.2.0"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}
                      kotoba-lang/kami-webgpu   {:local/root "../../kotoba-lang/webgpu"}}}}}
