;; shadow-cljs build for the FLOW browser host adapter (ADR-2607100900
;; follow-up (b) -- ClojureScript, since real-time beat timing + audio
;; are host-imports clojurewasm/kotoba-wasm can't provide yet, ADR-2607100030
;; addendum 2). output-dir == the dev-http root, same layout as
;; ghosthacker-echoes's browser build.
{:deps   {:aliases [:cljs]}
 :builds {:app {:target     :browser
                :output-dir "public"
                :asset-path "."
                :modules    {:main {:init-fn ghosthacker-flow.web/init}}
                :dev-http   {8292 "public"}}}}
